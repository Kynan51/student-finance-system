# Copy this file to `.env` and edit the values.
# The run scripts create `.env` from this file automatically on first run.

# ---- Django ----
DJANGO_DEBUG=True
# Generate a real key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Database ----
# sqlite = zero-setup quick start (a db.sqlite3 file is created)
# mysql  = the project's target database (create the DB first, see README)
DB_ENGINE=sqlite
DB_NAME=student_finance
DB_USER=student_finance_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Email (password reset) ----
# Console backend prints reset emails in the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Student Finance <no-reply@localhost>

# ---- AI engine ----
AI_MIN_DAYS_FOR_FORECAST=14
AI_FORECAST_HORIZON_DAYS=30
